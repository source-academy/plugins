{
  "name": "@sourceacademy/web-module-loader",
  "version": "0.0.2",
  "packageManager": "yarn@4.18.0",
  "description": "The web plugin for the module loader in Source Academy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/plugins.git",
    "directory": "src/web/module-loader"
  },
  "scripts": {
    "build": "rollup -c",
    "prepack": "yarn build"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/conductor": "*"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@sourceacademy/common-module-loader": "workspace:*",
    "@sourceacademy/common-tabs": "workspace:^",
    "@sourceacademy/conductor": "catalog:",
    "rollup": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
