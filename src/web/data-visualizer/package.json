  "version": "0.0.1",
  "packageManager": "yarn@4.18.0",
  "description": "Host (web) plugin for the Source Academy data visualizer: classifies and renders drawn structures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/plugins",
    "directory": "src/web/data-visualizer"
  },
  "scripts": {
    "build": "rollup -c && node wrap.mjs",
    "prepack": "yarn build"
  },
