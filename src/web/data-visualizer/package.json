    "@sourceacademy/common-tabs": "workspace:^",
    "@sourceacademy/conductor": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "konva": "^9.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "react-test-renderer": "^19.0.0",
