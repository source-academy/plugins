{
  "name": "@sourceacademy/web-cse-machine",
  "version": "3.0.0",
  "packageManager": "yarn@4.18.0",
  "description": "The web/host-side CSE machine plugin: receives evaluation snapshots for rendering",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/plugins.git",
    "directory": "src/web/cse-machine"
  },
  "scripts": {
    "build": "rollup -c",
    "prepack": "yarn build"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/common-cse-machine": ">=0.3.0",
    "@sourceacademy/conductor": "*"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@sourceacademy/common-cse-machine": "workspace:*",
    "@sourceacademy/conductor": "catalog:",
    "@vitest/coverage-istanbul": "^4.1.9",
    "rollup": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
