{
  "name": "@sourceacademy/web-cse-machine",
  "version": "3.0.0",
  "packageManager": "yarn@4.18.0",
  "description": "The web/host-side CSE machine plugin: receives evaluation snapshots for rendering",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/plugins",
    "directory": "src/web/cse-machine"
  },
  "scripts": {
    "build": "rollup -c",
    "prepack": "yarn build"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/common-cse-machine": ">=0.3.0",
    "@sourceacademy/conductor": "^0.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sourceacademy/common-cse-machine": "workspace:*",
    "@sourceacademy/conductor": "^0.8.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
