{
  "name": "@sourceacademy/web-cse-machine",
  "version": "3.1.1",
  "packageManager": "yarn@4.18.1",
  "description": "Host (web) plugin for the Source Academy CSE machine: receives evaluation snapshots and contributes the CSE Machine tab",
  "scripts": {
    "build": "rollup -c && node wrap.mjs",
    "prepack": "yarn build"
  },
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "peerDependencies": {
    "@blueprintjs/core": ">=5",
    "@sourceacademy/common-cse-machine": ">=0.6.2",
    "@sourceacademy/common-tabs": ">=0.2.0",
    "@sourceacademy/conductor": "^0.8.0",
    "konva": ">=9",
    "react": ">=18",
    "react-dom": ">=18",
    "react-konva": ">=18"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.0.0",
    "@blueprintjs/icons": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sourceacademy/common-cse-machine": "workspace:*",
    "@sourceacademy/common-tabs": "workspace:^",
    "@sourceacademy/conductor": "^0.8.0",
    "@sourceacademy/web-environment-diagram": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "konva": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
