{
  "extends": "../tsconfig.json",
  "exclude": ["./dist"],
  "include": ["./src"],
  "compilerOptions": {
    "declaration": false,
    "outDir": "./dist",
    // The program pane reuses the stepper's renderer from ../stepper/src, so the root spans both.
    "rootDir": "..",
    "types": [],
    // The environment-diagram library is read from its source, not through the workspace link (a virtual path outside the root).
    "paths": { "@sourceacademy/web-environment-diagram": ["../environment-diagram/src/index.ts"] }
  }
}
