{
  "name": "@sourceacademy/web-test",
  "version": "0.0.2",
  "packageManager": "yarn@4.12.0",
  "description": "The test web plugin for the plugins repository",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/plugins",
    "directory": "src/web/test"
  },
  "scripts": {
    "build": "rollup -c",
    "prepack": "yarn build"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/common-tabs": "^0.0.1",
    "@sourceacademy/conductor": "*",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@sourceacademy/common-tabs": "workspace:^",
    "@sourceacademy/common-test": "workspace:*",
    "@sourceacademy/conductor": "catalog:",
    "@types/react": "^19.2.17",
    "rollup": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
