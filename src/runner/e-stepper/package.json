{
  "name": "@sourceacademy/runner-e-stepper",
  "version": "0.0.1",
  "packageManager": "yarn@4.18.1",
  "description": "Language-agnostic runner plugin for the Source Academy environment stepper (e-stepper)",
  "scripts": {
    "build": "rollup -c",
    "prepack": "yarn build",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "license": "ISC",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/common-e-stepper": ">=0.0.0",
    "@sourceacademy/common-stepper": ">=0.0.4",
    "@sourceacademy/conductor": "^0.8.0",
    "@sourceacademy/runner-stepper": ">=0.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@sourceacademy/common-e-stepper": "workspace:*",
    "@sourceacademy/common-stepper": "workspace:*",
    "@sourceacademy/conductor": "catalog:",
    "@sourceacademy/runner-stepper": "workspace:*",
    "rollup": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
