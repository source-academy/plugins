  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/common-cse-machine": ">=0.4.0",
    "@sourceacademy/common-stepper": ">=0.0.4"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sourceacademy/common-cse-machine": "workspace:*",
    "@sourceacademy/common-stepper": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "rollup": "^4.60.2",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
