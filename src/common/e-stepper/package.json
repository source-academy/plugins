{
  "name": "@sourceacademy/common-e-stepper",
  "version": "0.0.2",
  "packageManager": "yarn@4.18.1",
  "description": "Shared, language-agnostic protocol for the Source Academy environment stepper (e-stepper) plugin pair",
  "scripts": {
    "build": "rollup -c",
    "prepack": "yarn build",
    "test": "vitest",
    "test-coverage": "vitest --coverage"
  },
  "license": "ISC",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "@sourceacademy/common-cse-machine": ">=0.3.1",
    "@sourceacademy/common-stepper": ">=0.0.4"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "@sourceacademy/common-cse-machine": "workspace:*",
    "@sourceacademy/common-stepper": "workspace:*",
    "rollup": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
