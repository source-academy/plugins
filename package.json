{
  "name": "@sourceacademy/plugins-workspace",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "src/common/*/",
    "src/runner/*/",
    "src/web/*/"
  ],
  "type": "module",
  "scripts": {
    "build": "node lib/build.ts",
    "dev": "node lib/build.ts --watch",
    "run:all": "yarn workspaces foreach -pt -A --exclude \"@sourceacademy/plugins-workspace\" run",
    "run:since": "yarn workspaces foreach -pt --since --exclude \"@sourceacademy/plugins-workspace\" run",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test:dev": "vitest",
    "lint": "eslint --concurrency=auto src",
    "format": "prettier --write \"**/*.{ts,tsx,json,js,cjs,mjs}\"",
    "format:ci": "prettier --list-different \"**/*.{ts,tsx,json,js,cjs,mjs}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commander-js/extra-typings": "^15.0.0",
    "@sourceacademy/conductor": "catalog:",
    "@sourceacademy/plugin-directory": "source-academy/plugin-directory#main",
    "@types/node": "^25.9.1",
    "@vitest/coverage-istanbul": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.26",
    "@yarnpkg/types": "^4.0.1",
    "commander": "^15.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.57.1",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/plugins.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/source-academy/plugins/issues"
  },
  "homepage": "https://github.com/source-academy/plugins#readme"
}
